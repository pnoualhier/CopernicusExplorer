# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Copernicus Data Space Ecosystem (CDSE) ---
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# --- Sentinel Hub / CDSE Sentinel Hub APIs ---
# Configuration / OAuth client from Sentinel Hub dashboard
SENTINELHUB_CLIENT_ID=""
SENTINELHUB_CLIENT_SECRET=""
SENTINELHUB_INSTANCE_ID=""

# --- Copernicus Climate Data Store (CDS / ERA5) ---
# https://cds.climate.copernicus.eu/how-to-api
CDS_API_URL="https://cds.climate.copernicus.eu/api"
CDS_API_KEY=""

# --- Copernicus Atmosphere Data Store (ADS / CAMS) ---
# https://ads.atmosphere.copernicus.eu/how-to-api
ADS_API_URL="https://ads.atmosphere.copernicus.eu/api"
ADS_API_KEY=""

# --- Copernicus Marine Service (CMS) ---
# https://marine.copernicus.eu/
MARINE_USERNAME=""
MARINE_PASSWORD=""

# --- Cache / Storage ---
# Optional Redis URL. In-memory cache is used if not set.
REDIS_URL=""
PORT=3000

